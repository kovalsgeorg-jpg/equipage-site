# Скопируйте в .env.local и заполните.

# Точка интеграции формы заявки.
# Если переменная задана, API-роут /api/lead пересылает заявку POST-запросом
# (JSON) на этот адрес: CRM-вебхук, Telegram-бот, почтовый шлюз — любой приёмник.
# Если не задана, форма честно сообщает посетителю, что онлайн-приём пока
# не подключён, и показывает телефон и почту.
LEAD_WEBHOOK_URL=

# Номер счётчика Яндекс Метрики (только цифры). Пусто — счётчик не грузится.
# Сайт отправляет цели: lead_submit (отправка формы), phone_click (клик по телефону).
NEXT_PUBLIC_METRIKA_ID=
